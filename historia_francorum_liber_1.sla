        <PAGEOBJECT XPOS="136.0008" YPOS="17528.0688" OwnPage="41" ItemID="1691374627" PTYPE="4" WIDTH="522" HEIGHT="265.561773248417" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 265.562 L0 265.562 L0 0 Z" copath="M0 0 L522 0 L522 265.562 L0 265.562 L0 0 Z" gXpos="136.0008" gYpos="17528.0688" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="25. Dē passiōne apostolōrum atque Nerōne."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Beātus Petrus apostolus iit ad Rōmam sub imperātōre Claudiō, quārtō ab Augustō. In Rōmā Petrus praedicāvit, et conprobāvit Chrīstum esse fīlium Deī in multīs virtūtibus. Ab illīs diēbus erant multī Chrīstiānī apud cīvitātem Rōmānam. Tunc erat invidia in corde imperātōris. Nam Nerō ille luxuriōsus, vānus atque superbus, excitāvit persecūtiōnem prīmus contrā Chrīstiānōs. Nerō habēbat sēcum Simōnem magum, virum malitiae et magicae artis. Nerō iussit Petrum interficī cruce et Paulum interficī gladiō. Sed erat sēditiō contrā Nerōnem et Nerō sē interfēcit cum manū propriā prope Rōmam."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
