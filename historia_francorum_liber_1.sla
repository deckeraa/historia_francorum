        <PAGEOBJECT XPOS="136.0008" YPOS="20856.0816" OwnPage="49" ItemID="1712415299" PTYPE="4" WIDTH="522" HEIGHT="207.35789044587" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 207.358 L0 207.358 L0 0 Z" copath="M0 0 L522 0 L522 207.358 L0 207.358 L0 0 Z" gXpos="136.0008" gYpos="20856.0816" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="30. Dē septem virīs in Gallīs ad praedicandum missīs."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Sub Deciō imperātōre, erant multa bella adversum nōmen Chrīstiānum. Nōn possumus numerāre martyrēs. Babillās episcopus Antiochēnsis cum tribus parvolīs, id est Urban, Prilidan et Epolōn, et Xystus Rōmānae ecclēsiae episcopus et Laurentius archidiāconus et Hyppolitus cōnsummātī sunt per martyrium ob cōnfessiōnem dominicī nōminis."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Valentīniānus et Novatiānus tunc erant prīncipēs hereticōrum."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
