        <PAGEOBJECT XPOS="136.0008" YPOS="14200.056" OwnPage="33" ItemID="1677217747" PTYPE="4" WIDTH="522" HEIGHT="469.60005095542" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 469.6 L0 469.6 L0 0 Z" copath="M0 0 L522 0 L522 469.6 L0 469.6 L0 0 Z" gXpos="136.0008" gYpos="14200.056" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="16. Dē nātīvitāte Chrīstī."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Isrāhēlitae reversī sunt per Zorobabel, sīcut dīximus, sed murmurābant contrā Deum et contemnēbant prophētās Deī. Dominus, reprōmissus vōcibus patriarchārum prophētārumque vōcibus, nātus est ex Marīā Virgine dē Spīritū Sānctō. Ā trānsmigrātiōne ergō ūsque nātīvitātem Chrīstī generātiōnēs 14, id est Iechoniās, Salathiel, Zorobabil, Abiud, Eliachim, Azor, Sadoch, Achim, Eliuth, Eleazar, Mathan, Iācōb, Iōsēph, vir Marīae, dē quā dominus noster Iēsūs Chrīstus nāscitur."/>
                <para PARENT="Latin"/>
                <ITEXT CH="17. Dē dīversīs gentium rēgnīs."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="[This section contains a list of kings reigning over various peoples. The text was not a good candidate for simplification; please refer to the original text if you wish to read it.]"/>
                <para PARENT="Latin"/>
                <ITEXT CH="18. Quō tempore Lugdūnum sit condita."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Post hōs, Iūlius Caesar fuit imperātor prīmus. Iūlius Caesar obtinuit monarchiam imperiī. Secundus imperātor erat Octāviānus, nepōs Iūliī Caesaris, quem Augustum vocant, ā quō et mēnsis Augustus est vocitātus. Cuius nōnō decimō imperiī annō, Lugdūnum Galliārum condita est."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
