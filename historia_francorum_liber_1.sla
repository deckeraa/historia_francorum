            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="It (the name Zoroaster) means 'living star'."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
