        <PAGEOBJECT XPOS="136.0008" YPOS="16696.0656" OwnPage="39" ItemID="1691295651" PTYPE="4" WIDTH="522" HEIGHT="478.762425477715" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 478.762 L0 478.762 L0 0 Z" copath="M0 0 L522 0 L522 478.762 L0 478.762 L0 0 Z" gXpos="136.0008" gYpos="16696.0656" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="23. Dē diē resurrēctiōnis dominicae."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Crēdimus quod resurrēctiō Dominī erat in diē prīmā, nōn septimā, sīcut multī putant. Prīma lūx erat in diē prīmā in prīncipiō; ergō prīma diēs meruit vidēre Dominum resurgentem dē sepulchrō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Ā captīvitāte vērō Hierosolymītānae et dēsōlātiōne templī ūsque ad passiōnem dominī nostrī Iēsū Chrīstī, id est ūsque Tiberiī septimō decimō annō, supputantur annī 668."/>
                <para PARENT="Latin"/>
                <ITEXT CH="24. Dē ascēnsiōne Dominī."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Dē ascēnsiōne Dominī et dē interitū Pīlātī atque Hērōdis. Dominus resurrēxit et per quadrāgintā diēs dīcēbat cum discipulīs dē rēgnō Deī, tunc iit in nūbe in caelum et resēdit ad dexteram Patris. Pīlātus autem scrīpsit gesta Chrīstī in epistulā et mīsit gesta ad Tiberium Caesarem. Quae gesta apud nōs hodiē retinentur scrīpta. Tiberius lēgit gesta in senātū. Pīlātus autem nōn erat impūnītus, ob scelere suae malitiae, et sē interfēcit cum propriīs manibus. Sīc et Hērōdēs rēx, dum saevit apostolōs Dominī, percussus est dīvīnitus ob tanta scelera; Hērōdēs habēbat vermēs in ventre eius et quoque sē interfēcit cum propriīs manibus."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
