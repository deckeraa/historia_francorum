        <PAGEOBJECT XPOS="136.0008" YPOS="19192.0752" OwnPage="45" ItemID="1703982467" PTYPE="4" WIDTH="522" HEIGHT="537.453462420392" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 537.453 L0 537.453 L0 0 Z" copath="M0 0 L522 0 L522 537.453 L0 537.453 L0 0 Z" gXpos="136.0008" gYpos="19192.0752" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="27. Dē persecūtiōne sub Traiānō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Traiānus, tertius post Nerōnem, mōvit persecūtiōnem in Chrīstiānōs. Sub quō beātus Clēmēns -- quī fuit episcopus tertius Rōmānae ecclēsiae -- passus est. Et Sānctus Simion episcopus Hierosolymītānus crucīfīxus est prō Chrīstī nōmine. Et Ignātius episcopus Antiochēnsis ductus est ad Rōmam, et dēputābātur cum bēstiīs. Haec ācta sunt sub temporibus Traiānī."/>
                <para PARENT="Latin"/>
                <ITEXT CH="28. Dē Adriānō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Dē Adriānō et adinventiōnibus hēreticōrum et passiōne sānctī Policarpī atque Iūstīnī. Post hunc, Adriānus erat imperātor. Adriānus reparāvit Hierosolymam et vocāvit Hierosolymam 'Aelia"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH="' ab Aeliō Adriānō."/>
                <para PARENT="Latin"/>
                <ITEXT CH=" "/>
                <tab/>
                <ITEXT CH="Sub Antōnīnī imperiō, heresis īnsāna surrēxit, nōmine Marcionītāna et Valentīniāna."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Et Iūstīnus philosophus scrīpsit librōs catholicae ecclēsiae. Tunc Iūstīnus philosophus corōnātus est cum martyriō prō Chrīstī nōmine. In Asiā persecūtiō surrēxit et beātissimus Policarpus corōnātus est cum martyriō prō Chrīstī nōmine. Policarpus erat discipulus Iōhannis apostolī. Et in Gallīs multī corōnātī sunt cum gemmīs caelestibus per martyrium prō Chrīstī nōmine. Habēmus hodiē historiās passiōnum eārum."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="19729.5286624204" OwnPage="45" ItemID="1704028851" PTYPE="4" WIDTH="522" HEIGHT="133.810150318481" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 133.81 L0 133.81 L0 0 Z" copath="M0 0 L522 0 L522 133.81 L0 133.81 L0 0 Z" gXpos="136.0008" gYpos="19729.5286624204" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="He called Jerusalem Aelia, after Aelius Hadrianus."/>
                <ITEXT CH=" Aelius Hadrianus was the successor of Domitian. After the failed bar Kokhba rebellion of ~132 AD, Hadrian rebuilt Jerusalem and renamed it to Aelia Capitolina."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
