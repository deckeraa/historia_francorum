                <para PARENT="Vocab"/>
                <ITEXT CH="sānctōrum: of the saints; plural masculine genitive from sānctus, sānctī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sanguinis: of blood; singular masculine genitive from sanguis, sanguinis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="scrīpsit: he wrote; 3rd person singular perfect from scrībō, scrībere, scrīpsī, scrīptum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="sīcque: thus, thusly; -que adds 'and' in front of a word"/>
