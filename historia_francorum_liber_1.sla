        <PAGEOBJECT XPOS="136.0008" YPOS="18360.072" OwnPage="43" ItemID="1700095507" PTYPE="4" WIDTH="522" HEIGHT="293.889783439499" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 293.89 L0 293.89 L0 0 Z" copath="M0 0 L522 0 L522 293.89 L0 293.89 L0 0 Z" gXpos="136.0008" gYpos="18360.072" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="26. Dē Iacobō, Mārcō et Iōhanne ēvangelistā."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Stephanus erat prīmus martyr. Tunc Iacobus, frāter Dominī, et Mārcus ēvangelista corōnātī sunt cum martyriō glōriōsō prō Chrīstī nōmine. Post necem Iacobī apostolī, erat magna calamitās contrā Iūdaeōs. Nam Vespasiānus advēnit et interfēcit sexcenta mīlia Iūdaeōrum cum gladiō et fame. Quoque templum incēnsum est. Domiciānus autem, secundus post Nerōnem, saeviit Chrīstiānōs, et relēgāvit Iōhannem apostolum in īnsulam Pathmos. Post mortem Domiciānī, beātus Iōannēs apostolus rediit dē exiliō; quī senex et plēnus diērum vīvēns"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" sē dēposuit in sepulchrō. Hic Iōannēs fertur nōn gustāre mortem, dōnec Dominus rediit, ipsō in ēvangeliīs ita dīcente: Sīc eum volō manēre, dōnec veniam."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="18653.9617834395" OwnPage="43" ItemID="1700622739" PTYPE="4" WIDTH="522" HEIGHT="49.52866242038" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 49.5287 L0 49.5287 L0 0 Z" copath="M0 0 L522 0 L522 49.5287 L0 49.5287 L0 0 Z" gXpos="136.0008" gYpos="18653.9617834395" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Living he placed himself in the grave."/>
                <ITEXT CH=" The idea is that John is in stasis, resting alive in a sepulchre until the Day of Judgement."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
