                <para PARENT="Vocab"/>
                <ITEXT CH="quī: who; singular masculine nominative from quī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Raguēl: Reuel, son of Esau via Basemath. See Genesis 36:10."/>
