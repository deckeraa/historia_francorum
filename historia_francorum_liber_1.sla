        <PAGEOBJECT XPOS="136.0008" YPOS="30840.12" OwnPage="73" ItemID="1869805555" PTYPE="4" WIDTH="522" HEIGHT="414" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 414 L0 414 L0 0 Z" copath="M0 0 L522 0 L522 414 L0 414 L0 0 Z" gXpos="136.0008" gYpos="30840.12" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="44. Dē Urbicō Arvernōrum episcopō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Urbicus erat prīmus episcopus apud Arvernōs post Stremōnium. Urbicus conversus est ex senātōribus et habēbat uxōrem. Iuxtā cōnsuētūdinem ecclēsiasticam, nōn habitābat cum uxōre suā. Sed invidia inimīcī, quae semper est inimīcus sanctitātis, conmovētur in fēminā; quam in concupīscentiam virī succendēns, novam Ēvam effēcit. Nam"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" succēnsa mulier ā libīdine, perrēxit ad domum ecclēsiae per tenebrās noctis. Uxor eius pulsāvit forēs ecclēsiae et dīxit: 'Quoūsque"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" sacerdōs dormīs? Cūr uxōrem tuam spernis? Cūr obdūrātīs auribus Paulī praecepta nōn audīs? Scrīpsit enim: Revertiminī"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" ad alterutrum, nē temptet vōs Satanās. Ecce! Ego ad tē revertor, nec ad extrāneum, sed ad proprium vās recurrō'. Religiō sacerdōtis tepuit et Urbicus iussit eam intrāre cubiculum. Nāta est enim fīlia ab hōc conceptū, quae in religiōne permansit."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Posteā, Urbicus erat trīstis et fēcit paenitentiam."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="In cuius locō Legonus episcopus subrogātur."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="31254.12" OwnPage="73" ItemID="1826373443" PTYPE="4" WIDTH="522" HEIGHT="92.1783439490464" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 92.1783 L0 92.1783 L0 0 Z" copath="M0 0 L522 0 L522 92.1783 L0 92.1783 L0 0 Z" gXpos="136.0008" gYpos="31254.12" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="(Envy) enkindling her in desire of (her) man, it made a new Eve."/>
                <ITEXT CH=" This is an odd comparison to make, since the sin of Eve was eating of the forbidden fruit, not having normal sexual relations with her husband. That, in fact, was something she was commanded to do."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="How long do you, the priest, sleep?"/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH="This is a gloss on 1 Corinthians 7:5-40."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
