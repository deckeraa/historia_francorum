        <PAGEOBJECT XPOS="136.0008" YPOS="24184.0944" OwnPage="57" ItemID="1723106083" PTYPE="4" WIDTH="522" HEIGHT="356.440631847148" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 356.441 L0 356.441 L0 0 Z" copath="M0 0 L522 0 L522 356.441 L0 356.441 L0 0 Z" gXpos="136.0008" gYpos="24184.0944" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="32. Dē Chrocō et dē dēlūbrō Arvernō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Valeriānus et Galliēnus, imperātōrēs Rōmānī, commōvērunt gravem persecūtiōnem contrā Chrīstiānōs. Tunc Cornilius Rōmae, et Cypriānus Cartaginem, inlūstrārunt fēlīcī sanguine. Et, in tempore hōrum, Chrocus ille Alamannōrum rēx invāsit Galliās. Chrocus subvertit ā fundāmentīs cūnctās aedēs, quae antīquitus fabricātae fuerant."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Chrocus vēnit Arvernum et subvertit dēlūbrum in Arvernō, quod vocant Gallicā linguā Vasso Galāte. Hic templum factum fuit cum mīrō opere. Pariēs"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" templī duplex erat, ab intus enim dē minūtō lapide, ā forīs vērō quadrīs sculptīs fabricātus fuit. Habuit enim pariēs ille crassitūdinem pedēs trīgintā. Intrīnsecus vērō marmore ac mūsēō variātum"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" erat, pavīmentum quoque aedis marmore strātum, dēsuper vērō plumbum tēctum."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="24540.5350318471" OwnPage="57" ItemID="1723526467" PTYPE="4" WIDTH="522" HEIGHT="65.1210191082791" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 65.121 L0 65.121 L0 0 Z" copath="M0 0 L522 0 L522 65.121 L0 65.121 L0 0 Z" gXpos="136.0008" gYpos="24540.5350318471" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The wall of the temple was double, and from the inside (it was made) from minute stone, from the outside it had been fabricated from sculpted squares."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And inside it was variagated/tiled with marble and mosaic, the floor of the temple also having been laid out with marble."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
