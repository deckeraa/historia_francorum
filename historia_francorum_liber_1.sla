        <PAGEOBJECT XPOS="136.0008" YPOS="29176.1136" OwnPage="69" ItemID="1836767987" PTYPE="4" WIDTH="522" HEIGHT="235.657100636963" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 235.657 L0 235.657 L0 0 Z" copath="M0 0 L522 0 L522 235.657 L0 235.657 L0 0 Z" gXpos="136.0008" gYpos="29176.1136" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="41. Dē interitū Valentis imperātōris."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Post mortem autem Valentīniānī, Valēns erat successor integrī imperiī. Valēns iussit cōgī"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" monachōs ad mīlitiam. Valēns praecēpit nōlentēs verberārī fūstibus. Post haec, Rōmānī gessērunt bellum saevissimum in Thrāciās, in quō tanta strāgēs fuit, ut Rōmānī, āmissō"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" equōrum praesidiō, pedibus fūgērunt. Valēns vulnerātus est ā sagittā et adiit in parvum tugurium. Gothī incendērunt tugurium, et Valēns mortuus est. Sīcque ultiō dīvīna prōcessit ob effūsiōne sanguinis sānctōrum."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Hūcusque"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" Hieronimus; ab hōc vērō tempore Orosius presbyter plūs scrīpsit."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="29411.7707006369" OwnPage="69" ItemID="1861898803" PTYPE="4" WIDTH="522" HEIGHT="67.8726114649689" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 67.8726 L0 67.8726 L0 0 Z" copath="M0 0 L522 0 L522 67.8726 L0 67.8726 L0 0 Z" gXpos="136.0008" gYpos="29411.7707006369" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Valens ordered the monks to be forced into the military."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="With the help of the horses having been lost."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And up to this point (this historical has used as a source) St. Jerome; and from this time Orosius the elder wrote more."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.0008" YPOS="29176.1136" OwnPage="70" ItemID="1829204867" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.0008" gYpos="29176.1136" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ā: from, out of, by"/>
                <para PARENT="Vocab"/>
