        <PAGEOBJECT XPOS="136.0008" YPOS="31672.1232" OwnPage="75" ItemID="1861491619" PTYPE="4" WIDTH="522" HEIGHT="471.520112101935" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 471.52 L0 471.52 L0 0 Z" copath="M0 0 L522 0 L522 471.52 L0 471.52 L0 0 Z" gXpos="136.0008" gYpos="31672.1232" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="45. Dē sānctō Illidiō episcopō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Legonus mortuus est, et sānctus Illidius successit eī et erat episcopus apud Arvernōs. Illidius erat vir eximiae sanctitātis ac praeclārae virtūtis. Fāma eius etiam adiit ad extrāneōs fīnēs. Illidius cūrāvit fīliam imperātōris Trevēricī quae habēbat spīritum inmundum. Quod memorāvimus in librō illō, quem dē eius vītā cōnscrīpsimus."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Illidius erat senex et plēnus diērum plēnusque bonīs operibus. Illidius migrāvit ad Chrīstum et sepultus est in cryptā suburbānā cīvitātis illīus."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Huic sānctus Nepotianus successit."/>
                <para PARENT="Latin"/>
                <ITEXT CH="46. Dē Nepotianō atque Artemiō episcopīs."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Igitur apud Arvernōs sānctus Nepotianus erat quārtus episcopus."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Erat vir, nōmine Artemius, quī erat lēgātus missus ā Trēverīs in Spāniam. Correptus est cum vī febrium. Hic Artemius relictus est aegrōtus apud Arvernōs. Nepotianus vīsitāvit eum et perūnxit eum cum oleō sānctō. Tunc Artemius nōn erat aegrōtus. Ergō Artemius remānsit apud Arvernōs, studēbat religiōnem, factus est clēricus, et posteā successit Nepotianō."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.0008" YPOS="31672.1232" OwnPage="76" ItemID="1884149427" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.0008" gYpos="31672.1232" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
