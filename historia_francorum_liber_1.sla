        <PAGEOBJECT XPOS="136.0008" YPOS="32504.1264" OwnPage="77" ItemID="1864407539" PTYPE="4" WIDTH="522" HEIGHT="380.612453503207" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 380.612 L0 380.612 L0 0 Z" copath="M0 0 L522 0 L522 380.612 L0 380.612 L0 0 Z" gXpos="136.0008" gYpos="32504.1264" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="47. Dē castitāte amantium."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Per idem tempus, erat vir cuius nōmen erat Iniūriōsus. Iniūriōsus erat quīdam dē senātōribus Arvernīs. Iniūriōsus expetiit puellam in coniugiō et statuit diem nūptiārum. Erat"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" autem uterque ūnicus patrī. Advēnit diēs, celebrāvērunt sollemnitātēs nūptiārum, et erant in ūnō strātō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Sed puella erat graviter contrīstāta, vertit ad parietem, et flēbat amarissimē. Cui ille iuvenis: 'Quid', inquit, 'turbāris? Indicā, quaesō, mihi'. Illa puella erat silēns, et ille addidit: 'Obsecrō tē per Iēsūm Chrīstum, fīlium Deī, ut expōnās mihi quid doleās."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Tunc illa conversa ad eum ait: &quot;Statueram"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" enim, ut servārem corpusculum meum inmaculātum Chrīstō ā virīlī tāctū, sed vae mihi! Ab Chrīstō relicta sum! Nōn nunc potuī perficere id quod prōmīsī! Sed quid amplius"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" verba prōtrahimus? Īnfēlīx ego, quae dēbuī sorte merērī caelōs, hodiē dēmergō in abyssōs.&quot;"/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="32884.2802547771" OwnPage="77" ItemID="1854940819" PTYPE="4" WIDTH="522" HEIGHT="89.8853503184728" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 89.8854 L0 89.8854 L0 0 Z" copath="M0 0 L522 0 L522 89.8854 L0 89.8854 L0 0 Z" gXpos="136.0008" gYpos="32884.2802547771" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Each one was the only (child) of (their) father."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="For I had decided that I would preserve my body, to Christ, immaculate from manly touch, but woe to me!"/>
                <ITEXT CH=" The woman had taken a vow of virginity, but had ended up getting married, and she was worried that she would be unable to fulfill her vow."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="But why do we more amply prolong words?"/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
