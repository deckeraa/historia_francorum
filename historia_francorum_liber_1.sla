        <PAGEOBJECT XPOS="136.0008" YPOS="11704.0464" OwnPage="27" ItemID="1665390403" PTYPE="4" WIDTH="522" HEIGHT="357.100096815289" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 357.1 L0 357.1 L0 0 Z" copath="M0 0 L522 0 L522 357.1 L0 357.1 L0 0 Z" gXpos="136.0008" gYpos="11704.0464" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="11. Dē populō in dēsertō et Iosūe."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Isrāhēlitae erant in erēmō per 40 annōs. Accipiunt lēgēs et pāscuntur victibus angelicīs. Tunc trānsiērunt Iordanēn cum Iēsū Nāve et accipiunt terram reprōmissiōnis."/>
                <para PARENT="Latin"/>
                <ITEXT CH="12. Dē captīvitāte populī Isrāhēlīticī et generātiōnibus ūsque Dāvīd."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Isrāhēlitae, post trānsitum, postpōnunt praecepta dīvīna et saepe subiugantur in servitiō aliēnigenārum. Sed ingemīscunt Deō et, tribuente Dominō, līberantur per brachium virōrum fortium. Post haec, Isrāhēlitae postulant rēgem ā Dominō, sīcut reliquae gentēs habent; accipiunt prīmum Saūl, deinde Dāvīd. Ab Ābrahām ergō ūsque ad Dāvīd generātiōnēs 14: id est Ābrahām, Isaāc, Iācōb, Iūdās, Phārēs, Esdrom, Āram, Aminadab, Naasōn, Salma, Boaz, Obeth, Iesse, Dāvīd. Dāvīd autem genuit Salamōnem dē Bersabee."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
