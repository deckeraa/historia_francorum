        <PAGEOBJECT XPOS="136.0008" YPOS="13368.0528" OwnPage="31" ItemID="1673101843" PTYPE="4" WIDTH="522" HEIGHT="384.40579872612" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 384.406 L0 384.406 L0 0 Z" copath="M0 0 L522 0 L522 384.406 L0 384.406 L0 0 Z" gXpos="136.0008" gYpos="13368.0528" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="15. Dē captīvitāte in Babylōniā."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Dominus, īrātus contrā eōs, excitāvit Nabūchodonosor, quī abdūxit eōs captīvōs in Babylōniam cum omnibus ōrnāmentīs templī. In quā captīvitāte, Danihel prophēta erat inlaesus inter ēsurientēs leōnēs, et trēs puerī erant inlaesī in mediō īgnium. In hāc captīvitāte Hiezechihēl prophētāvit et Hesdrās prophēta nātus est. Ā Dāvīd autem ūsque ad dēsōlātiōnem templī et trānsmigrātiōnem in Babylōniā generātiōnēs 14, id est Dāvīd, Salamōn, Roboam, Abia, Asa, Iosaphath, Ioram, Ozia, Ioatha, Achaz, Ezechihēl, Mannasēs, Amōn, Iosiās. In hīs ergō 14 generātiōnibus annī inveniuntur numerō 390. Dē hāc vērō captīvitāte līberantur per Zorobabel. Posteā, Zorobabel restituit et templum et cīvitātem. Sed haec captīvitās gerit typum illīus captīvitātis in quā anima peccātrīx abdūcitur: nisi Zorobabel, id est Chrīstus, līberāverit, anima exsulāvit horribiliter. Ipse enim Dominus in ēvangeliō dīcit: Sī vōs Fīlius līberāverit, vērē līberī eritis. Haec vērō captīvitās annīs 70 fuisse dīcitur."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.0008" YPOS="13368.0528" OwnPage="32" ItemID="1673083939" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.0008" gYpos="13368.0528" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
