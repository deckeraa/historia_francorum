        <PAGEOBJECT XPOS="136.0008" YPOS="34168.1328" OwnPage="81" ItemID="1865659875" PTYPE="4" WIDTH="522" HEIGHT="441.854461146526" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 441.854 L0 441.854 L0 0 Z" copath="M0 0 L522 0 L522 441.854 L0 441.854 L0 0 Z" gXpos="136.0008" gYpos="34168.1328" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="48. Dē trānsitū sānctī Mārtīnī."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="In secundō annō imperiī Arcadiī et Honoriī, sānctus Mārtīnus Turonicōrum episcopus, plēnus virtūtibus et sanctitāte, fēlīciter migrāvit ad Chrīstum. Sānctus Mārtīnus erat in octōgēsimō et prīmō annō aetātis suae. Trānsiit in mediā nocte, quae dominica habēbātur, Atticō Caesariōque cōnsulibus. Sānctus Mārtīnus erat apud Condatinsem dum trānsiit. Multī audīērunt, in eius trānsitū, psallentium in caelum, quod in librō virtūtum eius prīmō plēnius exposuimus."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Quandō Sānctus Mārtīnus erat aeger, Pictavī populī convēnērunt ad eius trānsitum, sīcut Turonicī. Quō migrante, grandis altercātiō surrēxit. Dīcēbant enim Pictavī: &quot;Noster est monachus, nōbīs abbās erat, nōs dēbēmus habēre corpus eius.&quot; Ad haec Turonicī respondēbant: &quot;Nōn, nōs dēbēmus habēre corpus eius. Sānctus Mārtīnus suscitāvit duōs mortuōs vōbīs, nōbīs ūnum. Ergō necesse est, ut, quod nōbīscum nōn inplēvit vīvēns, expleat dēfūnctus. Certē, sī prō monastēriō"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" prīvilēgium cupitis vindicāre, scītōte, quia prīmum eī monastērium cum Mediolanensibus fuit.&quot;"/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="34610.9044585987" OwnPage="81" ItemID="1894816467" PTYPE="4" WIDTH="522" HEIGHT="40.8152866242017" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 40.8153 L0 40.8153 L0 0 Z" copath="M0 0 L522 0 L522 40.8153 L0 40.8153 L0 0 Z" gXpos="136.0008" gYpos="34610.9044585987" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Certainly, if you want to claim (the body of Saint Martin) on account of the privilege with the monastery, know that his first monastery was with (in) Milan."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
