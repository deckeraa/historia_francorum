        <PAGEOBJECT XPOS="136.0008" YPOS="33336.1296" OwnPage="79" ItemID="1862812995" PTYPE="4" WIDTH="522" HEIGHT="351.615622929959" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 351.616 L0 351.616 L0 0 Z" copath="M0 0 L522 0 L522 351.616 L0 351.616 L0 0 Z" gXpos="136.0008" gYpos="33336.1296" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Iuvenis ait: &quot;Parentēs nostrī nōn habent līberōs aliōs, et voluērunt nōs habēre līberōs, ad prōpāgandum generātiōnem.&quot; Cui illa: &quot;Nihil est mundus, nihil sunt dīvitiae, nihil est pompa saeculī huius; sōlā volō contemplārī Deum.&quot; Ad haec ille: &quot;Cum dulcissimīs ēloquiīs tuīs, vīta aeterna inlūxit mihi. Sī vīs abstinēre ā carnālī concupīscentiā, tē adiuvābō.&quot; Puella dīxit: &quot;Grātiās"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" tibi agō.&quot;"/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Et datīs"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" dextrīs inter sē, quiēvērunt, recumbentēs in ūnō strātō multōs annōs posteā, sed cum castitāte laudābilī, quod posteā in eōrum trānsitū dēclārātum est."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Nam cum, implētō certāmine, puella migrāret"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" ad Chrīstum, vir perēgit officium fūneris cum puellā in sepulchrō. Puella, quamquam mortua erat, loquēbātur cum eō in hōc diē. Nōn multō post, vir quoque mortuus est. Vir et puella sepultī sunt in dīversīs locīs, sed, māne"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" factō, invēnērunt sepulchra pariter. Ūsque hodiē incolae vocitant locum 'Duōs Amantēs'. Meminimus dē hīs in librō Mīrāculōrum."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="33687.7452229299" OwnPage="79" ItemID="1867190611" PTYPE="4" WIDTH="522" HEIGHT="102.267515923566" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 102.268 L0 102.268 L0 0 Z" copath="M0 0 L522 0 L522 102.268 L0 102.268 L0 0 Z" gXpos="136.0008" gYpos="33687.7452229299" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Thank you."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And with their right (hands) being given between them."/>
                <ITEXT CH=" They were holding hands."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And when, the struggle (of earthly life against sin) was complete, the girl departed (from this life) to Christ."/>
                <ITEXT CH=" The subjunctive is used here as part of a circumstantial clause."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The husband and wife were buried in different locations, but, it having become morning, they found the graves together."/>
                <ITEXT CH=" The miracle was that the graves moved together on their own overnight."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
