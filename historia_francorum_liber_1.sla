                <ITEXT CH="ob: towards, for, because of"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="Orosius: Paulus Orosius (~375-420 AD), a Roman historian, theologian, and student of Augustine of Hippo; singular masculine nominative from Orosius, Orosiī"/>
