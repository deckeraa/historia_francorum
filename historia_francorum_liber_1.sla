        <PAGEOBJECT XPOS="136.0008" YPOS="27512.1072" OwnPage="65" ItemID="1828913683" PTYPE="4" WIDTH="522" HEIGHT="297" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 297 L0 297 L0 0 Z" copath="M0 0 L522 0 L522 297 L0 297 L0 0 Z" gXpos="136.0008" gYpos="27512.1072" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="37. Dē Iacobō Nisebēnō episcopō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Sub imperiō Cōnstantis Iacobus fuit episcopus Nisebēnī. Iacobus ōrāvit et praecēs eius reppulērunt multa perīcula ā cīvitāte. Et Maximīnus, episcopus Trēverōrum, erat potēns in omnī sanctitāte."/>
                <para PARENT="Latin"/>
                <ITEXT CH="38. Dē trānsitū Antōniī monachī."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="In nōnō decimō annō Cōnstantīnī iuniōris, Antōnius monachus trānsiit. Antōnius erat in annō centēsimō quīntō aetātis."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Beātissimus Helārius, Pictavensis episcopus, missus est in exilium per suāsum hēreticōrum. In exiliō, Helārius scrīpsit librōs prō fidē catholicā et mīsit Cōnstantiō; quī in quārtō annō exiliī iussit eum absolvī, et Helārius"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" rediit ad propria."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="27809.1072" OwnPage="65" ItemID="1602721235" PTYPE="4" WIDTH="522" HEIGHT="37.0074496815469" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 37.0074 L0 37.0074 L0 0 Z" copath="M0 0 L522 0 L522 37.0074 L0 37.0074 L0 0 Z" gXpos="136.0008" gYpos="27809.1072" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And Hilary returned to his own (land, things)."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
