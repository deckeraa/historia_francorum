        <PAGEOBJECT XPOS="136.0008" YPOS="2552.0112" OwnPage="5" ItemID="1623180835" PTYPE="4" WIDTH="522" HEIGHT="522" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 522 L0 522 L0 0 Z" copath="M0 0 L522 0 L522 522 L0 522 L0 0 Z" gXpos="136.0008" gYpos="2552.0112" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Chapter Heading"/>
                <ITEXT CH="Versiō Simplicissima"/>
                <para PARENT="Chapter Heading"/>
                <para PARENT="Chapter Heading"/>
                <ITEXT CH="Gregōriī Turonēnsis Historiārum Liber Prīmus"/>
                <para PARENT="Latin" ALIGN="1"/>
                <para PARENT="Latin"/>
                <ITEXT CH="Gregōriī praefātiō prīma incipit."/>
                <para PARENT="Latin" ALIGN="1"/>
                <tab/>
                <ITEXT CH="Cultūra litterārum līberālium periit ab urbibus Gallicānīs. Nēmō potest scrībere historiam. Ergō, scrīpsī historiam cum verbīs simplicibus, quia 'Paucī"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" hominēs intellegunt philosophantem rhētorem, sed multī intellegunt loquentem rūsticum'."/>
                <para PARENT="Latin"/>
                <ITEXT CH="Incipiāmus ā prīncipiō mundī."/>
                <para PARENT="Latin" ALIGN="1"/>
                <para PARENT="Latin"/>
                <ITEXT CH="Liber prīmus"/>
                <para PARENT="Latin" ALIGN="1"/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Scrībam dē bellīs rēgum cum gentibus adversīs, martyrum cum pāgānīs, et ecclēsiārum cum hēreticīs. Volō"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" scrībere prius fidem meam, ut quī lēgerit mē nōn dubitet esse catholicum."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Sed prius, precor"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" veniam legentibus, sī aut in litterīs aut in syllabīs grammaticam artem excesserō; nōn sum inbūtus adplēne in arte grammaticā."/>
                <para PARENT="Latin"/>
            </StoryText>
            <PageItemAttributes>
                <ItemAttribute Name="TOC" Type="none" Value="Liber 1: The Crusade is preached; the People's Crusade meets with disaster." Parameter="" Relationship="none" RelationshipTo="" AutoAddTo="none"/>
            </PageItemAttributes>
        </PAGEOBJECT>
