                <para PARENT="Vocab"/>
                <ITEXT CH="tempore: time; singular neuter ablative from tempus, temporis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="thrāciās: Thracians; plural feminine accusative from thrācius, thrācia, thrācium"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="tugurium: hut; singular neuter accusative from tugurium, tuguriī"/>
                <para PARENT="Vocab"/>
