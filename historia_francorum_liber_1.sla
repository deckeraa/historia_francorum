        <PAGEOBJECT XPOS="136.0008" YPOS="25848.1008" OwnPage="61" ItemID="1832341043" PTYPE="4" WIDTH="522" HEIGHT="320.459709554158" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 320.46 L0 320.46 L0 0 Z" copath="M0 0 L522 0 L522 320.46 L0 320.46 L0 0 Z" gXpos="136.0008" gYpos="25848.1008" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="35. Dē Quirīnō episcopō et martyre."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Dioclitiānus fēcit magnam persecūtiōnem contrā Chrīstiānōs per annōs quattuor. Eō tempore, Quirīnus erat sacerdōs ecclēsiae Sisciēnsis. Quirīnus erat martyr prō Chrīstī nōmine: pāgānī ligāvērunt saxum ad collum eius et inpulērunt eum in gurgitem flūminis. Quirīnus cecidit in gurgitem, sed ferēbātur super aquās dīvīnā virtūte. Multī hominēs vīdērunt et, dispectō"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" furōre gentīlium, voluērunt līberāre Quirīnum. Sed Quirīnus nōluit subtrahī ā martyriō et ōrāvit: 'Iēsū domine, quī glōriōsus residēs ad dexteram Patris, nē patiāris"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" mē ab hōc stadiō removērī, sed suscipiēns animam meam, coniungere mē tuīs martyribus in requiē sempiternā dīgnāre'. Et, hīs"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" dictīs, reddidit spīritum. Chrīstiānī suscēpērunt corpus eius et sepelīvērunt eum."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="26168.5605095541" OwnPage="61" ItemID="1811834531" PTYPE="4" WIDTH="522" HEIGHT="108.229299363054" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 108.229 L0 108.229 L0 0 Z" copath="M0 0 L522 0 L522 108.229 L0 108.229 L0 0 Z" gXpos="136.0008" gYpos="26168.5605095541" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="With the rage of the heathens having been contemplated."/>
                <ITEXT CH=" The people saw the pagan rage against Quirinus but still decided they wanted to free him, due to the miraculous flotation."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Do not suffer me to be removed from this stadium, but, receiving my soul, deign to join me with your martyrs in eternal rest."/>
                <ITEXT CH=" Quirinus didn't want to be saved from the 'stadium' of the river's whirlpool, but rather wished to become a martyr."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="With these (things) having been said."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
