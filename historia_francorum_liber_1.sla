        <PAGEOBJECT XPOS="136.0008" YPOS="28344.1104" OwnPage="67" ItemID="1825295203" PTYPE="4" WIDTH="522" HEIGHT="324.73036433123" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 324.73 L0 324.73 L0 0 Z" copath="M0 0 L522 0 L522 324.73 L0 324.73 L0 0 Z" gXpos="136.0008" gYpos="28344.1104" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="39. Dē adventū sānctī Mārtīnī."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Tunc lūmen nostrum advēnit, hoc erat eō tempore beātissimus Mārtīnus exōrsus est praedicāre in Galliās. Mārtīnus dēclārāvit, in populīs, Chrīstum esse fīlium Deī. Mārtīnus fēcit multa mīrācula. Mārtīnus āvertit incrēdulitātem gentīlium. Hic enim fāna dēstrūxit, heresem oppressit, ecclēsiās aedificāvit, et restituit trēs mortuōs ad vītam. In quārtō annō Valentīniānī et Valentis, sānctus Helārius apud Pictavōs, plēnus sanctitāte et fidē, migrāvit ad caelōs."/>
                <para PARENT="Latin"/>
                <ITEXT CH="40. Dē Melaniā mātrōnā."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Melania, mātrōna nōbilis et incola urbis Rōmae, abiit Hierosolymam ob dēvōtiōnem. Quae ita sē praebuit in cūnctā bonitāte ac sanctitāte omnibus, ut Thecla"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" vocārētur ab incolīs."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="28668.8407643312" OwnPage="67" ItemID="1849249603" PTYPE="4" WIDTH="522" HEIGHT="49.5286624203836" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 49.5287 L0 49.5287 L0 0 Z" copath="M0 0 L522 0 L522 49.5287 L0 49.5287 L0 0 Z" gXpos="136.0008" gYpos="28668.8407643312" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="So that she was called Thecla by the inhabitants."/>
                <ITEXT CH=" The name Thecla is probably a reference to the character in the apocryphal work The Acts of Paul and Thecla."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
