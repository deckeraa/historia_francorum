        <PAGEOBJECT XPOS="136.0008" YPOS="8376.0336" OwnPage="19" ItemID="1812409458" PTYPE="4" WIDTH="522" HEIGHT="213.214807643311" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 213.215 L0 213.215 L0 0 Z" copath="M0 0 L522 0 L522 213.215 L0 213.215 L0 0 Z" gXpos="136.0008" gYpos="8376.0336" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="8. Dē Isaāc, Isau, et Iōb et Iācōb."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Ābrahām erat centum annōrum et genuit Isaāc. Isaāc erat in annō sexāgēsimō aetātis et fīliī geminī nātī sunt dē Rebeccā. Prīmus erat Esau, quī vēndidit prīmōgenita sua. Ipse est pater Idūmaeōrum, dē cuius generātiōne quārtā nātus est Iobab, hoc est Isau, Raguēl, Zara, Iobab, quī"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" et Iōb. Iōb vīxit annōs 249. In octōgēsimō nōnō annō ab īnfirmitāte"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" līberātus est. Post īnfirmitātem autem 170 annīs, restitūtā in duplum"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" omnī facultāte."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="8589.24840764331" OwnPage="19" ItemID="139692578" PTYPE="4" WIDTH="522" HEIGHT="140.636942675161" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 140.637 L0 140.637 L0 0 Z" copath="M0 0 L522 0 L522 140.637 L0 140.637 L0 0 Z" gXpos="136.0008" gYpos="8589.24840764331" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Jobab, who is (also called) Job."/>
                <ITEXT CH=" Gregory's assertion is that the Jobab, the great-grandson of Esau, is the titular character of book of Job. Gregory may have gotten this from the LXX version of Job, which directly states in 42:17b-17c that Job is the Jobab descended from Abraham. However, this is in a textual variant that claims to gets its information from a Syriac book, so the canonicity of the verses could be called into question. There is some internal evidence in Job that supports the identification of Job with Jobab; for example, one of his friends is called Eliphaz the Temanite and Teman is mentioned as a grandson of Esau in Genesis 36:11."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH="The Devil struck Job will an illness in Job 2:7."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH="After Job's trial, God restored to him twice the amount of things that he had lost."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.0008" YPOS="8376.0336" OwnPage="20" ItemID="1808508802" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.0008" gYpos="8376.0336" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
