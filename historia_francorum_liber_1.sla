        <PAGEOBJECT XPOS="136.0008" YPOS="21688.0848" OwnPage="51" ItemID="1713170851" PTYPE="4" WIDTH="522" HEIGHT="299.43112356689" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 299.431 L0 299.431 L0 0 Z" copath="M0 0 L522 0 L522 299.431 L0 299.431 L0 0 Z" gXpos="136.0008" gYpos="21688.0848" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Huius tempore septem virī episcopī, ōrdinātī ad praedicandum, missī sunt in Galliīs."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Hiī ergō missī sunt:"/>
                <para PARENT="Latin"/>
                <ITEXT CH=" - Turonicīs Gatiānus episcopus,"/>
                <para PARENT="Latin"/>
                <ITEXT CH=" - Arelātēnsibus Trophimus episcopus,"/>
                <para PARENT="Latin"/>
                <ITEXT CH=" - Narbōnae Paulus episcopus,"/>
                <para PARENT="Latin"/>
                <ITEXT CH=" - Tholōsae Sāturnīnus episcopus,"/>
                <para PARENT="Latin"/>
                <ITEXT CH=" - Parīsiacīs Dionisius episcopus,"/>
                <para PARENT="Latin"/>
                <ITEXT CH=" - Arvernīs Stremōnius episcopus,"/>
                <para PARENT="Latin"/>
                <ITEXT CH=" - Lemovicīnīs Mārtiālis episcopus."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.0008" YPOS="21688.0848" OwnPage="52" ItemID="1716990803" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.0008" gYpos="21688.0848" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
