        <PAGEOBJECT XPOS="136.0008" YPOS="26680.104" OwnPage="63" ItemID="1830062195" PTYPE="4" WIDTH="522" HEIGHT="295.590267515941" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 295.59 L0 295.59 L0 0 Z" copath="M0 0 L522 0 L522 295.59 L0 295.59 L0 0 Z" gXpos="136.0008" gYpos="26680.104" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="36. Dē nātīvitāte sānctī Mārtīnī et crucis inventiōne."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Cōnstantīnus erat trīcēsimus quārtus imperātor, et rēgnāvit fēlīciter annīs trīgintā. Cōnstantīnus dedit pācem ecclēsiīs et nōn erat persecūtiō sīcut in tempore Dioclitiānī. In annō ūndecimō imperiī Cōnstantīnī, beātissimus Mārtīnus nātus est apud Sabāriam Pannoniae cīvitātem. Mārtīnus nātus est dē parentibus gentīlibus, nōn tamen īnfimīs. Hic Cōnstantīnus, in annō vīcēsimō imperiī, interfēcit Crīspum, fīlium suum, cum venēnō, et Faustam, coniugem suam, cum balneō calente, quia Fausta et Crīspus voluērunt capere rēgnum. Huius tempore, lignum venerābile crucis dominicae, per"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" studium Helenae mātris, repertum est. Ūsque hoc tempus historiographus in chronicīs scrībit Eusebius"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH="."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="26975.6942675159" OwnPage="63" ItemID="1845074307" PTYPE="4" WIDTH="522" HEIGHT="83.4649681528645" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 83.465 L0 83.465 L0 0 Z" copath="M0 0 L522 0 L522 83.465 L0 83.465 L0 0 Z" gXpos="136.0008" gYpos="26975.6942675159" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Through the study of (his) mother Helen."/>
                <ITEXT CH=" Constantine's mother Helen was credited with recovering the wood of the cross upon which Christ was crucified."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH="This sentence indicates that Gregory has been using the church historian Eusebius as a source up until this point."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
