                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Iōsēph ab Arimathīā sepelīvit Iēsūm in suō monumentō. Prīncipēs sacerdōtum adprehendērunt Iōsēph et inclūsērunt eum in cellulam. Dominus resurgit et custōdēs territī sunt ā vīsiōne angelicā. Quoque, parietēs dē cellulā, in quā Iōsēph tenēbātur, suspenduntur in altīs. Iōsēph fugit, et parietēs restitūtī sunt in locum eōrum. Māne, pontificēs dīxērunt mīlitibus: &quot;Ubi est Chrīstus, quem vōs cūstōdiēbātis?&quot;. Mīlitēs respondērunt: &quot;Prius, reddite nōbīs Iōsēph, quem vōs cūstōdiēbātis.&quot; Pontificēs nōn potuērunt respondēre, et mīlitēs sub hāc excūsātiōne līberantur."/>
                <para PARENT="Latin"/>
                <ITEXT CH="22. Dē Iacobō apostolō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Iacobus apostolus vīdit Dominum mortuum in cruce. Iacobus iūrāvit numquam sē comēsūrum"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" pānem, nisi Dominum cerneret resurgentem. Dominus spoliāvit Tartarum cum triumphō et rediit in tertiā diē. Dominus ostendit sē Iacobō et dīxit: 'Surge, Iacobe, et comede, quia iam ā mortuīs resurrēxī'. Hic est Iacobus iūstus quī erat frāter Dominī."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="16276.5859872611" OwnPage="37" ItemID="1690581971" PTYPE="4" WIDTH="522" HEIGHT="58.7006369426763" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 58.7006 L0 58.7006 L0 0 Z" copath="M0 0 L522 0 L522 58.7006 L0 58.7006 L0 0 Z" gXpos="136.0008" gYpos="16276.5859872611" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="James swore to never eat bread (again), unless he saw the Lord rising again."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
