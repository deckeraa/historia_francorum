        <PAGEOBJECT XPOS="136.0008" YPOS="5880.024" OwnPage="13" ItemID="1838527170" PTYPE="4" WIDTH="522" HEIGHT="450" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 450 L0 450 L0 0 Z" copath="M0 0 L522 0 L522 450 L0 450 L0 0 Z" gXpos="136.0008" gYpos="5880.024" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="4. Dē dīluviō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Dominus commōtus est contrā inīquitātēs populī. Dominus mīsit dīluvium et interfēcit omnēs. Sed Dominus cōnservāvit Noē et familiam eius in arcā. Illa arca est typus ecclēsiae. Ipsa ecclēsia enim nāvigābat inter flūctūs et scopulōs huius saeculī et dēfendit nōs ab inminentibus malīs."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Ab Ādām ergō ūsque ad Noē generātiōnēs 10, id est Ādām, Seth, Enos, Cainan, Malalehel, Iareth, Enoch, Mattusalam, Lamech, Noē. In hīs ergō decem generātiōnibus inveniuntur annī 2242. Ādām sepultus est in terrā Enacim, quae prius Ebrōn vocābātur."/>
                <para PARENT="Latin"/>
                <ITEXT CH="5. Dē Chus et īdōlatrīā."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Noē habēbat trēs fīliōs post dīluvium: Sem, Cham et Iafeth. Omnēs gentēs sunt dē Sem, Cham et Iafeth. Cham habēbat fīlium, nōmine Chus. Chus erat adinventor artis magicae. Chus quoque adōrāvit staticulōs et fēcit īdōlatrīam. Chus, cum virtūte diabolī, fēcit īgnem et stēllās cadere dē caelō. Chus trānsiit ad Persās. Persae vocitāvērunt eum Zōroastrēn, id"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" est vīventem stēllam."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
