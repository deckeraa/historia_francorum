        <PAGEOBJECT XPOS="136.0008" YPOS="4216.0176" OwnPage="9" ItemID="1797853650" PTYPE="4" WIDTH="522" HEIGHT="302.097049681529" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 302.097 L0 302.097 L0 0 Z" copath="M0 0 L522 0 L522 302.097 L0 302.097 L0 0 Z" gXpos="136.0008" gYpos="4216.0176" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Crēdō sānctum Spīritum ā Patre et Fīliō prōcessisse"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=", nōn minōrem et quasi ante nōn esset, sed aequālem et semper cum Patre et Fīliō coaeternum deum, cōnsubstantiālem"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" nātūrā, aequālem omnipotentiā, consempiternum"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" esse essentiā et nunquam sine Patre fuisse vel Fīliō, neque minōrem Patrī vel Fīliō. Crēdō hanc Trīnitātem sānctam in distīnctiōne"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" subsistere persōnārum, et aliam quidem persōnam Patris, aliam Fīliī, aliam Spīritūs Sānctī. In quā Trīnitāte ūnam Deitātem, ūnam potentiam, ūnam essentiam esse, cōnfiteor. Crēdō"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" beātam Marīam, ut virginem ante partum, ita virginem et post partum. Crēdō animam immortālem, nec tamen partem"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT CH=" habēre Deitātis. Et omnia quae ā 318 episcopīs Niceae īnstitūta sunt crēdō fidēliter."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="4518.11464968153" OwnPage="9" ItemID="1821924130" PTYPE="4" WIDTH="522" HEIGHT="258.03821656051" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 258.038 L0 258.038 L0 0 Z" copath="M0 0 L522 0 L522 258.038 L0 258.038 L0 0 Z" gXpos="136.0008" gYpos="4518.11464968153" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="I believe the Holy Spirit to have proceeded from the Father and the Son."/>
                <ITEXT CH=" For more discussion on this, see Aquinas' Summa Theologia, Part 1 Q. 36."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Consubstantial by nature."/>
                <ITEXT CH=" The three divine persons (Father, Son, and Holy Spirit) have one being/essence/substance."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="To be co-eternal according to essence."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="I believe this Holy Trinity to subsist in distinction of the persons; indeed one person is the Father, another the Son, another the Holy Spirit."/>
                <ITEXT CH=" Regarding the Trinity, we ought to neither divide the substance nor confuse the persons."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="I believe the blessed Mary, as she was a virgin before brith, thus she was also after birth."/>
                <ITEXT CH=" The idea that Mary remained a virgin after the birth of Christ (and therefore never had physical relations with Joseph) is referred to as Perpetual Virginity. "/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="I believe in the immortal soul, nor do I believe it to have part of Diety."/>
                <ITEXT CH=" Gregory here is rejecting the idea that the human soul is consubstantial or 'part' of God."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.0008" YPOS="4216.0176" OwnPage="10" ItemID="139897970" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.0008" gYpos="4216.0176" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ā: from, out of, by"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="aequālem: equal; singular masculine accusative from aequālis, aequāle"/>
