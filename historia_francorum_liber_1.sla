        <PAGEOBJECT XPOS="136.0008" YPOS="5048.0208" OwnPage="11" ItemID="1658547058" PTYPE="4" WIDTH="522" HEIGHT="421.533340127389" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 421.533 L0 421.533 L0 0 Z" copath="M0 0 L522 0 L522 421.533 L0 421.533 L0 0 Z" gXpos="136.0008" gYpos="5048.0208" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="1. Dē Ādām et Ewā."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="In prīncipiō, Dominus, in Chrīstō suō, fēcit caelum et terram. Tunc fēcit hominem ad suam imāginem et insufflāvit in faciem eius spīrāculum vītae. Ādām dormīvit et mulier Ewa creāta est dē costā eius. Ādām, antequam"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" peccāret, erat typus Redēmptōris. Chrīstus"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" erat in sopōre passiōnis, prōdūxit aquam dē latere suō, et fēcit ecclēsiam."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Ādām et Ewa vīvēbant inter amoena paradīsī, sed trānsiluērunt dīvīna praecepta et ēiectī sunt ex paradīsō."/>
                <para PARENT="Latin"/>
                <ITEXT CH="2. Dē Cain et Abel."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Ewa concēpit et peperit duōs fīliōs. Deus suscēpit sacrificium Abel dīgnanter, et Cain tumuit invidiā īnflammante. Cain cōnsurrēxit et interfēcit frātrem eius."/>
                <para PARENT="Latin"/>
                <ITEXT CH="3. Dē Enoch iūstō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Cūnctum genus hominum erat malum, sed Enoch erat iūstus. Enoch ambulāvit in viīs Deī. Deus līberāvit eum dē mediō peccantis populī et tulit eum in caelum."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="5469.55414012739" OwnPage="11" ItemID="1811116898" PTYPE="4" WIDTH="522" HEIGHT="99.0573248407636" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 99.0573 L0 99.0573 L0 0 Z" copath="M0 0 L522 0 L522 99.0573 L0 99.0573 L0 0 Z" gXpos="136.0008" gYpos="5469.55414012739" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Adam, before he sinned, was a type of the Redeemer."/>
                <ITEXT CH=" A 'type' here refers to a literary foreshadowing of Christ."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Christ was in the slumber of suffering, he produced water from his side and made the church."/>
                <ITEXT CH=" After Christ died during the crucifixion, his side was pierced with a spear and water and blood poured forth. The analogy being made is that Eve was taken from the side of Adam, and the 'New Eve' was taken from the side of the 'New Adam'."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
