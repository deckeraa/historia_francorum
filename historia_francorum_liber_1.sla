        <PAGEOBJECT XPOS="136.0008" YPOS="7544.0304" OwnPage="17" ItemID="1824117026" PTYPE="4" WIDTH="522" HEIGHT="394.00781656051" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 394.008 L0 394.008 L0 0 Z" copath="M0 0 L522 0 L522 394.008 L0 394.008 L0 0 Z" gXpos="136.0008" gYpos="7544.0304" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="7. Dē Ābrahām et Ninō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Prīmus autem fīlius Noē erat Sēm; dē quō generātiōne decimā nātus est Ābrahām: id est Noē, Sēm, Arphaxath, Sale, Eber, Falech, Rheū, Saruch, Thare, quī genuit Ābrahām. In hīs ergō decem generātiōnibus, hoc est ā Noē ūsque Ābrahām, inveniuntur annī 942. Eō tempore rēgnābat Ninus, quī aedificāvit Ninum cīvitātem, quam Ninevēn vocant. Quadrāgēsimō tertiō annō huius rēgnī nātus est Ābrahām. Hic"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" Ābrahām est initium fideī nostrae. Hic Ābrahām accēpit reprōmissiōnēs."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Deus iussit Ābrahām sacrificāre fīlium eius, nōmine Isaāc. Sed antequam Ābrahām posset"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" sacrificāre fīlium, Deus dedit Ābrahām animal et iussit Ābrahām sacrificāre animal et nōn Isaāc. Haec commūtātiō victimae mōnstrāvit quōmodo Chrīstus crucīfīxus est prō nōbīs."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Hoc holocaustum, quod Ābrahām sacrificāvit, erat in monte Calvāriae, quō Dominus crucīfīxus est."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="7938.03821656051" OwnPage="17" ItemID="1849955090" PTYPE="4" WIDTH="522" HEIGHT="199.337579617834" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 199.338 L0 199.338 L0 0 Z" copath="M0 0 L522 0 L522 199.338 L0 199.338 L0 0 Z" gXpos="136.0008" gYpos="7938.03821656051" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="This is Abraham, the beginning of our faith."/>
                <ITEXT CH=" By 'beginning' Gregory is referring to how Abraham was a major figure in redemption history, not that he was absolutely the first believer in the true God."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="But before Abraham could sacrifice his son."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
