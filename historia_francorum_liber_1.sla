        <PAGEOBJECT XPOS="136.0008" YPOS="9208.0368" OwnPage="21" ItemID="1652764035" PTYPE="4" WIDTH="522" HEIGHT="476.345365605097" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 476.345 L0 476.345 L0 0 Z" copath="M0 0 L522 0 L522 476.345 L0 476.345 L0 0 Z" gXpos="136.0008" gYpos="9208.0368" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="9. Dē Iōsēph in Aegyptō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Secundus fīlius Rebeccae erat Iācōb. Deus dīlēxit Iācōb, sīcut ait per prophētam: Iācōb dīlēxī, Esau autem odiō"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" habuī. Iācōb, post angelicam lūctam, vocātus est Isrāhēl, ā quō Isrāhēlitae. Hic genuit duodecim patriarchās, quōrum haec sunt nōmina: Rūbēn, Simeōn, Lēvī, Iūdās, Isachar, Zabūlōn, Dān, Nepthalim, Gad et Āsēr. Post hōs genuit Iōsēph dē Rāchēle; erat in annō nōnāgēsimō secundō aetātis suae."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Iōsēph, habēns annum sextum decimum aetātis suae, vīdit somnia. Iōsēph dīxit somnia frātribus, et generāvit odium cum frātribus."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Frātrēs eius vēndidērunt eum in captīvitāte. Posteā, cum inminente fame, frātrēs eius dēscendērunt in Aegyptum, et cognitī sunt ā Iōsēph."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Post haec, cūnctī Isrāhēlitae dēscendunt in Aegyptum. Iācōb, post benedictōs fīliōs suōs in Aegyptō, moritur. Iācōb sepelītur ā Iōsēph in sepulchrō patris suī in terrā Canaan. Mortuō"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" autem Iōsēph atque Pharaōne, cūncta generātiō subicitur servitūtī. Quae līberātur per Moysēn post decem plāgās Aegyptī. Pharaō dēmersus est marī Rubrō."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="9684.3821656051" OwnPage="21" ItemID="1653349107" PTYPE="4" WIDTH="522" HEIGHT="44.0254777070058" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 44.0255 L0 44.0255 L0 0 Z" copath="M0 0 L522 0 L522 44.0255 L0 44.0255 L0 0 Z" gXpos="136.0008" gYpos="9684.3821656051" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Jacob I loved, but Esau I hated."/>
                <ITEXT CH=" Literally 'Esau I had in hate'."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="(When) however Joseph and Pharaoh were dead, the whole generation is subjected to slavery."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.0008" YPOS="9208.0368" OwnPage="22" ItemID="1655396227" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.0008" gYpos="9208.0368" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
