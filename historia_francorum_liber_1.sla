        <PAGEOBJECT XPOS="136.0008" YPOS="10872.0432" OwnPage="25" ItemID="1661181635" PTYPE="4" WIDTH="522" HEIGHT="326.937691719748" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 326.938 L0 326.938 L0 0 Z" copath="M0 0 L522 0 L522 326.938 L0 326.938 L0 0 Z" gXpos="136.0008" gYpos="10872.0432" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Hebraeī vēnērunt ad hoc stāgnum per dēsertum. Erant in artō locō. Pharaō voluit conclūdere eōs. Tunc Moysēs prōiēcit virgam suam super mare et mare dīvīsum est. Hebraeī iērunt per mare super terram siccam."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Nōnnūllī hominēs aiunt sulcōs, quōs rotae curruum fēcerant, ūsque hodiē permanēre et in profundō mare cernī."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Ille trānsitus maris, vel columna nūbis, gessit typum nostrī baptismatis, dīcente beātō Paulō apostolō: Nōlō vōs īgnōrāre, frātrēs, quia patrēs nostrī omnēs sub nūbe fuērunt, et omnēs in Moysēn baptīzātī sunt in nūbe et in mare.&quot; Columna vērō īgnis typum sānctī Spīritūs praetulit. Ā nātīvitāte ergō Ābrahae ūsque ad ēgressum fīliōrum Isrāhēl ex Aegyptō vel trānsitum maris Rubrī, quod fuit Moȳsī octōgēsimus annus, supputantur annī numerō 462."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
