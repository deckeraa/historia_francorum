        <PAGEOBJECT XPOS="136.0008" YPOS="6712.0272" OwnPage="15" ItemID="1806235122" PTYPE="4" WIDTH="522" HEIGHT="268.456876433122" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 268.457 L0 268.457 L0 0 Z" copath="M0 0 L522 0 L522 268.457 L0 268.457 L0 0 Z" gXpos="136.0008" gYpos="6712.0272" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="6. Dē Babylōniā."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Hominēs multiplicātī sunt. Ēgressī sunt ab Oriente et repperērunt campum, nōmine Senachar. In quō campō aedificābant cīvitātem. Volēbant cōnstruere turrem ūsque caelum. Sed Deus cōnfūtāvit linguam eōrum et dispersit eōs in ūniversā terrā. Nōmen cīvitātis erat Babēl, hoc est cōnfūsiō, eō quod Deus cōnfūtāvit linguās eōrum. Haec est Babylōnia ā Nebroth gigante aedificāta, fīliō Chus. Mūrus Babylōniae erat ex latere īnfūsō bitūmine. Mūrus habēbat in lātum cubitōs quīnquāgintā, altitūdinis cubitōs 200, in circuitū stadia 470. 25 portae per ūnumquodque latus sitae sunt, quae faciunt 100. Portae erant mīrae magnitūdinis et fōrmātae sunt ex aere."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.0008" YPOS="6712.0272" OwnPage="16" ItemID="1808651634" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.0008" gYpos="6712.0272" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
