        <PAGEOBJECT XPOS="136.0008" YPOS="23352.0912" OwnPage="55" ItemID="1719100739" PTYPE="4" WIDTH="522" HEIGHT="206.583959235682" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 206.584 L0 206.584 L0 0 Z" copath="M0 0 L522 0 L522 206.584 L0 206.584 L0 0 Z" gXpos="136.0008" gYpos="23352.0912" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="31. Dē ecclēsiā Biturigā."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Discipulī martyrum iērunt ad Biturigās cīvitātem et praedicāvērunt. Nōnnūllī hominēs crēdidērunt, et clēricī ōrdinātī sunt. Sed Chrīstiānī erant pauperēs et nōn potuērunt aedificāre ecclēsiam. Hominēs dīvitēs erant pāgānī et nōluērunt adiuvāre Chrīstiānōs. Sed ūnus vir, prīmus senātor Galliārum, quī erat dē stirpe Vectī Epagātī, factus est Chrīstiānus. Tunc dedit domum eius Chrīstiānīs, et Chrīstiānī domum suam fēcērunt ecclēsiam."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
