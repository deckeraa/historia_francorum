        <PAGEOBJECT XPOS="136.0008" YPOS="10040.04" OwnPage="23" ItemID="1656031683" PTYPE="4" WIDTH="522" HEIGHT="419.068280254778" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 419.068 L0 419.068 L0 0 Z" copath="M0 0 L522 0 L522 419.068 L0 419.068 L0 0 Z" gXpos="136.0008" gYpos="10040.04" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="10. Dē trānsitū rubrī maris."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Plūrēs hominēs dīxērunt multa dē hōc trānsitū maris. Nīlus dēcurrit per Aegyptum et inrigat agrōs. Multa monastēria nunc sunt in lītoribus Nīlī. Urbs magna est prope Nīlum, nōmine Babylōnia. Nōn est illa Babylōnia in quā turris magna aedificāta est, sed est alia urbs, nōmine Babylōnia (et nunc nōmine Cairo). In hāc urbe, Iōsēph aedificāvit horrea magna dē lapidibus quadrīs et caementō. Horrea"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" sunt capāciōra ad fundum et cōnstricta sunt ad summum, ubi per parvulum forāmen trīticum iactārētur. Haec horrea ūsque hodiē cernuntur."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Rēx Aegyptī, dē hāc cīvitāte, iit cum exercitū magnō ad persequendum Hebraeōs. Rēx iit ab Nīlō ad occidentālem plagam maris rubrī. Stāgnum, nōmine 'Gulf of Suez', dē mare Rubrō prōgreditur, habēns in longō mīlia circiter quīnquāgintā, in lātō autem decem et octō. In huius stāgnī capite Clysma cīvitās aedificāta est, nōn propter fertilitātem locī (erat sterile), sed propter portum. Nāvēs ab Indiīs veniēbant ad portum Clysmae."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="10459.1082802548" OwnPage="23" ItemID="1656223091" PTYPE="4" WIDTH="522" HEIGHT="69.0955414012751" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 69.0955 L0 69.0955 L0 0 Z" copath="M0 0 L522 0 L522 69.0955 L0 69.0955 L0 0 Z" gXpos="136.0008" gYpos="10459.1082802548" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="The storehouses are more spacious at the bottom and narrowed at the top, where wheat may be thrown in through a small opening."/>
                <ITEXT CH=" According to Gregory, the pyramids were built to store grain. This appears to be untrue, as the pyramids appear to be mostly solid."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
