                <para PARENT="Vocab"/>
                <ITEXT CH="Cūnctum: Every; singular neuter nominative from cūnctus, cūncta, cūnctum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="dē: from or of"/>
                <para PARENT="Vocab"/>
