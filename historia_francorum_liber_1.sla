        <PAGEOBJECT XPOS="136.0008" YPOS="15032.0592" OwnPage="35" ItemID="1685627651" PTYPE="4" WIDTH="522" HEIGHT="414.921691719752" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 414.922 L0 414.922 L0 0 Z" copath="M0 0 L522 0 L522 414.922 L0 414.922 L0 0 Z" gXpos="136.0008" gYpos="15032.0592" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="19. Dē mūneribus magōrum et necem īnfantium."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Annō 63 imperiī Augustī, dominus noster Iēsūs Chrīstus nātus est ex virgine Marīā in Bēthleem, oppidum Dāvīd. Magī ab oriente cernēbant immēnsum sīdus, vēnērunt cum mūneribus et adōrābant puerum. Hērōdēs, ob zēlō rēgnī suī, voluit interficere Chrīstum, et interfēcit multōs parvulōs īnfantēs. Posteā, Hērōdēs percussus est ā iūdiciō dīvīnō."/>
                <para PARENT="Latin"/>
                <ITEXT CH="20. Dē mīrābilibus et passiōne Chrīstī."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Dominus noster Iēsūs Chrīstus praedicāvit paenitentiam et fēcit multa signa et prōdigia: fēcit aquam in vīnum, extīnxit febrēs, līberāvit obsessōs ab inmundīs spīritibus, et fēcit alia multa. Sed Iūdaēī, plēnī invidiā, volēbant interficere eum. Ergō, ut veterum vātum conplērentur ōrācula, Chrīstus ā discipulō trāditur, ā pontificibus condemnātur, ā Iūdaeīs inlūditur, cum inīquīs crucīfīgitur, ā mīlitibus, āmissō spīritū, cūstōdītur. Tenebrae super ūniversum mundum factae sunt, et multī hominēs cōnfessī sunt Iēsūm esse fīlium Deī."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
