        <PAGEOBJECT XPOS="169.994430573248" YPOS="21987.5159235669" OwnPage="51" ItemID="1614406979" PTYPE="2" WIDTH="454.012738853503" HEIGHT="410.445859872601" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.102739889830438" LOCALSCY="0.102739889830438" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="7_urbes.png" IRENDER="0" EMBEDDED="0" path="M0 0 L454.013 0 L454.013 410.446 L0 410.446 L0 0 Z" copath="M0 0 L454.013 0 L454.013 410.446 L0 410.446 L0 0 Z" gXpos="169.994430573248" gYpos="21987.5159235669" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="136.0008" YPOS="25016.0976" OwnPage="59" ItemID="1791744067" PTYPE="4" WIDTH="522" HEIGHT="415.953355414029" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 415.953 L0 415.953 L0 0 Z" copath="M0 0 L522 0 L522 415.953 L0 415.953 L0 0 Z" gXpos="136.0008" gYpos="25016.0976" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="33. Dē martyribus quī circā Arvernum passī sunt."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Iuxtā hanc urbem, Liminius et Antoliānus martyrēs requiēscunt. Ibi Cassius ac Victorīnus sunt adeptī caelōrum rēgnum pariter per effūsiōnem cruōris propriī. Victorīnus erat servus sacerdōtis antedīctī templī. Victorīnus iit ad vīcum, in quō Cassius habitābat, ad persequendōs Chrīstiānōs. Victorīnus repperit Cassium esse Chrīstiānum. Sed, mōtus mīrāculīs et praedicātiōnibus Cassiī, Victorīnus crēdidit Chrīstō et erat magnus in virtūte. Nec multō post, Cassius et Victorīnus vēnērunt pariter per martyrium ad rēgnum caelōrum."/>
                <para PARENT="Latin"/>
                <ITEXT CH="34. Dē sānctō Prīvātō martyre."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Alamannī invādēbant in Galliās. Sānctus Prīvātus, episcopus urbis Gabalitānae, erat in cryptā montis prope urbem. Chrocus iit ad urbem cum exercitū et repperit Prīvātum in monte. Chrocus iussit Prīvātum immolāre daemoniīs. Prīvātus refūtāvit, caedēbātur fūstibus, et mortuus est. Chrocus, autem, iit apud Arelātēnsum Galliārum urbem, verberātus est cum gladiō, et mortuus est, ob scelera eius contrā Deum."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.0008" YPOS="25016.0976" OwnPage="60" ItemID="1824148579" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.0008" gYpos="25016.0976" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
