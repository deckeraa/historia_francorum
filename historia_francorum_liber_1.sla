        <PAGEOBJECT XPOS="136.0008" YPOS="12536.0496" OwnPage="29" ItemID="1669117011" PTYPE="4" WIDTH="522" HEIGHT="414.778425477713" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 414.778 L0 414.778 L0 0 Z" copath="M0 0 L522 0 L522 414.778 L0 414.778 L0 0 Z" gXpos="136.0008" gYpos="12536.0496" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="13. Dē Salamōne et aedificātiōne templī."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Dāvīd mortuus est et fīlius eius coepit rēgnāre. Dominus appāruit eī et dīxit: &quot;Quod vīs, tibi dabō&quot;. Salamōn postposuit terrēnās dīvitiās et petiit sapientiam. Dominus respondit: &quot;Quia nōn quaesīstī rēgna mundī nec dīvitiās eius, sed postulāstī sapientiam, ideō accipiēs eam. Ante tē nōn fuit"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" sapiēns sīc, et post tē nōn erit.&quot; Salamōn conprobāvit sapientiam eius in iūdiciō, in quō duae mulierēs lītigāvērunt dē ūnō īnfante. Hic Salamōn aedificāvit templum nōminī Dominī mīrō opere. In templō erat multum aurī argentīque. Ab ēgressū ergō fīliōrum Isrāhēl ex Aegyptō ūsque ad aedificātiōnem templī, quod fuit annus septimus rēgnī Salamōnis, inveniuntur annī 480."/>
                <para PARENT="Latin"/>
                <ITEXT CH="14. Dē dīvīsiōne rēgnī Isrāhēlīticī."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Post mortem autem Salamōnis, rēgnum dīvīsum est in duās partēs per dūritiam Roboae. Roboam rēgnābat duās tribūs, quod Iūdā appellābātur; Hieroboam rēgnābat decem tribūs, quod Isrāhēl vocābātur. Post haec dēclīnāvērunt ad īdōlatrīam."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="12950.8280254777" OwnPage="29" ItemID="1669687635" PTYPE="4" WIDTH="522" HEIGHT="34.394904458597" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 34.3949 L0 34.3949 L0 0 Z" copath="M0 0 L522 0 L522 34.3949 L0 34.3949 L0 0 Z" gXpos="136.0008" gYpos="12950.8280254777" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Before you no one was this wise, and after you (no one) will be (as wise as you)."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
