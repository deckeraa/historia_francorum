                <para PARENT="Vocab"/>
                <ITEXT CH="deitātem: deity; singular feminine accusative from deitās, deitātis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="deitātis: deity's; singular feminine genitive from deitās, deitātis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="deum: god; singular masculine accusative from deus, deī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="distīnctiōne: distinction; singular feminine ablative from distīnctiō, distīnctiōnis"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="episcopīs: bishops; plural masculine ablative from episcopus, episcopī"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="esse: to be; present active infinitive from sum, esse, fuī, futūrum"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="essentiā: essence; singular feminine ablative from essentia, essentiae"/>
                <para PARENT="Vocab"/>
                <ITEXT CH="essentiam: essence; singular feminine accusative from essentia, essentiae"/>
