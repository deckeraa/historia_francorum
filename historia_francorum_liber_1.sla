        <PAGEOBJECT XPOS="136.0008" YPOS="20024.0784" OwnPage="47" ItemID="1708154819" PTYPE="4" WIDTH="522" HEIGHT="325.781472611474" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 325.781 L0 325.781 L0 0 Z" copath="M0 0 L522 0 L522 325.781 L0 325.781 L0 0 Z" gXpos="136.0008" gYpos="20024.0784" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="29. Dē sānctō Phōtīnō, Hireneō vel reliquīs martyribus Lugdūnēnsibus."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Ex quibus martyribus, Sānctus Phōtīnus erat prīmus episcopus Lugdūnēnsis ecclēsiae. Phōtīnus erat plēnus diērum et passus est prō Chrīstī nōmine. Beātissimus Hireneus erat successor huius martyris. Hireneus dīrēctus est ad hanc urbem ā beātō Policarpō. Hireneus reddidit cīvitātem ad Chrīstiānam in parvō spatiō temporis cum praedicātiōne suā. Sed persecūtiō vēnit, et diabolus fēcit bella per tyrannum, et tanta ibi multitūdō Chrīstiānōrum iugulāta est ob cōnfessiōne Chrīstī, ut per platēās flūmina currerent dē sanguine Chrīstiānō. Nōn possumus numerāre illōs martyrēs, nec possumus colligere nōmina eōrum, sed Dominus habet nōmina eōrum in librō vītae. Beātus Hireneus quoque dēdicāvit vītam eius per martyrium. Post hunc, 48 martyrēs passī sunt, ex quibus prīmum fuisse legimus Vectium Epagātum."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.0008" YPOS="20024.0784" OwnPage="48" ItemID="1708306419" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.0008" gYpos="20024.0784" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
