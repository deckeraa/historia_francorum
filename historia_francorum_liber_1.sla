                <ITEXT CH="available."/>
                <para PARENT="Introduction"/>
                <ITEXT CH="    - to provide a legible (not photo-copied) text with macrons."/>
                <para PARENT="Introduction"/>
                <ITEXT CH="    - to provide glossaries so that a Latin learner could read through this work without needing to consult additional books or dictionaries."/>
                <para PARENT="Introduction"/>
                <ITEXT CH="    - to provide footnotes and maps."/>
                <para PARENT="Introduction"/>
                <ITEXT CH="    - to provide a simplified version of the text to give intermediate students an easy introduction to the vocabulary and concepts used in the original version."/>
                <para PARENT="Introduction"/>
                <para PARENT="Introduction"/>
                <tab/>
                <ITEXT CH="An electronic version of this book and more resources are available at https://comprehensiblelatin.com."/>
                <para PARENT="Introduction"/>
                <para PARENT="Introduction"/>
                <tab/>
                <ITEXT CH="This reader's edition of the "/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Historia Francōrum"/>
                <ITEXT CH=" is not a critical edition of the text; for that, please consult the critical edition by TODO which is cited in the bibliography. The glosses provided in the footnotes are intentionally woodenly literal; their purpose is to aid the reader in understanding the Latin, not to provide an idiomatic English translation. The glossaries for each page are created by a computer program I wrote that allows me to quickly set a parsed definition for each word and then outputs the page-specific glossaries. AI tools were not used to generate the glossaries."/>
                <para PARENT="Introduction"/>
                <para PARENT="Introduction"/>
                <tab/>
                <ITEXT CH="TODO"/>
                <para PARENT="Introduction"/>
                <ITEXT CH="  "/>
                <para PARENT="Introduction"/>
                <ITEXT CH=" "/>
                <tab/>
                <para PARENT="Introduction"/>
                <para PARENT="Introduction"/>
                <para PARENT="Introduction"/>
                <para PARENT="Introduction"/>
                <tab/>
                <para PARENT="Introduction"/>
                <para PARENT="Introduction"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Fīnis intrōductiōnis."/>
