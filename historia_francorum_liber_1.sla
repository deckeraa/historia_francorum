        <PAGEOBJECT XPOS="136.0008" YPOS="30008.1168" OwnPage="71" ItemID="1826431955" PTYPE="4" WIDTH="522" HEIGHT="352.036066242061" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 352.036 L0 352.036 L0 0 Z" copath="M0 0 L522 0 L522 352.036 L0 352.036 L0 0 Z" gXpos="136.0008" gYpos="30008.1168" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="42. Dē imperiō Theodosiī."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Grātiānus imperātor crēvit rem pūblicam esse dēstitūtam, et fēcit Theodosium collēgam eius. Hic Theodosius posuit omnem spem suam atque fīdūciam in misericordiam Deī. Theodosius"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" conpēscuit multās gentēs nōn tam gladiō quam vigiliīs et ōrātiōne, et rem pūblicam cōnfirmāvit. Theodosius erat victor et ingressus est Cōnstantīnopolim urbem."/>
                <para PARENT="Latin"/>
                <ITEXT CH="43. Dē interitū Maximī tyrannī."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Maximus ā mīlitibus imperātor creātus est. Maximus oppressit Brittānnōs per tyrannidem. Maximus interfēcit Grātiānum imperātōrem cum dolīs. Ad hunc Maximum beātus Mārtīnus, iam episcopus, vēnit. Tunc Theodosius, quī tōtam spem in Deum posuerat, suscēpit tōtum imperium in locō Grātiānī. Et Theodosius interfēcit Maximum."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="30360.6114649682" OwnPage="71" ItemID="1838008323" PTYPE="4" WIDTH="522" HEIGHT="38.9808917197442" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 38.9809 L0 38.9809 L0 0 Z" copath="M0 0 L522 0 L522 38.9809 L0 38.9809 L0 0 Z" gXpos="136.0008" gYpos="30360.6114649682" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Theodosius restrained many peoples not such much with the sword but rather with vigils and prayer, and he strengthened the republic."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="766.0008" YPOS="30008.1168" OwnPage="72" ItemID="1861315107" PTYPE="4" WIDTH="522" HEIGHT="720" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 720 L0 720 L0 0 Z" copath="M0 0 L522 0 L522 720 L0 720 L0 0 Z" gXpos="766.0008" gYpos="30008.1168" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
