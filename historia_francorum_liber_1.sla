                <para PARENT="Vocab"/>
                <ITEXT CH="Valēns: Valens, Roman emperor from 364-378 AD. Reigned with Valentinian the Great.; singular masculine nominative from Valēns, Valentis"/>
                <para PARENT="Vocab"/>
