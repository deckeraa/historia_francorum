        <PAGEOBJECT XPOS="136.0008" YPOS="22520.088" OwnPage="53" ItemID="1717355011" PTYPE="4" WIDTH="522" HEIGHT="359.402445859887" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 359.402 L0 359.402 L0 0 Z" copath="M0 0 L522 0 L522 359.402 L0 359.402 L0 0 Z" gXpos="136.0008" gYpos="22520.088" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Dē hīs, beātus Dionisius, Parīsiōrum episcopus, erat martyr et fīnīvit praesentem vītam gladiō."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Sāturnīnus vērō, iam sēcūrus dē martyriō, dīcit duōbus presbyterīs suīs: 'Ecce ego iam immolor et tempus meae resolūtiōnis īnstat. Rogō, ut, ūsque dum dēbitum"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" fīnem impleam, ā vōbīs paenitus nōn relinquar'. Cumque conpraehēnsus ad Capitolium dūcerētur, relictus ab hīs, sōlus adtrahitur. Igitur dīxit: 'Domine Iēsū Chrīste, exaudī mē dē caelō sānctō tuō, ut numquam"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" haec ecclēsia dē hīs cīvibus mereātur habēre pontificem in sempiternum'. Quod ūsque nunc, episcopus Tholōsae nōn est cīvis Tholōsae. Hic"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" vērō taurī furentis vestīgiīs alligātus ac dē Capitoliō praecipitātus, vītam fīnīvit."/>
                <para PARENT="Latin"/>
                <tab/>
                <ITEXT CH="Gatiānus, Trophimus, Stremōnius, Paulus, et Mārtiālis, vīventēs in summā sanctitāte, expandērunt ecclēsiam Chrīstī."/>
                <para PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="22880.4076433121" OwnPage="53" ItemID="1717265555" PTYPE="4" WIDTH="522" HEIGHT="105.019108280256" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 105.019 L0 105.019 L0 0 Z" copath="M0 0 L522 0 L522 105.019 L0 105.019 L0 0 Z" gXpos="136.0008" gYpos="22880.4076433121" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="I ask that, until I fulfill the destined end, by you I not be left completely."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="So that this church would never deserve to have a priest from these (the city's own) citizens, ever."/>
                <ITEXT CH=" According to this curse, Toulouse would always bring it outsiders as a bishop, which in the next sentence Gregory states is the case in his day."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="But this one, having been tied to the feet of a raging bull and having been thrown off of the capitol hill, ended his life."/>
                <ITEXT CH=" Part of the execution was Saturnin being dragged by an angry bull."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
