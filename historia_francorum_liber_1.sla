        <PAGEOBJECT XPOS="136.0008" YPOS="3384.0144" OwnPage="7" ItemID="1624985219" PTYPE="4" WIDTH="522" HEIGHT="307.399612738854" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 307.4 L0 307.4 L0 0 Z" copath="M0 0 L522 0 L522 307.4 L0 307.4 L0 0 Z" gXpos="136.0008" gYpos="3384.0144" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Crēdō ergō in Deum patrem omnipotentem. Crēdō in Iēsūm Chrīstum, fīlium eius ūnicum, dominum nostrum, nātum"/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT CH=" ā patre, nōn factum, nōn post tempora, sed ante cūnctum tempus semper fuisse cum patre. Nec"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT CH=" enim pater dīcī potuerat, nisi habēret fīlium; neque fīlius esset, sī patrem utique nōn habēret. Illōs"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT CH=" vērō, quī dīcunt: 'Erat quandō nōn erat', exsēcrābiliter rennuō et ab ecclēsiā sēgregāre contestor. Crēdō Chrīstum hunc verbum esse patris, per quem facta sunt omnia. Hunc"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT CH=" verbum carne factum crēdō, cuius"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT CH=" passiōnem mundus redēmptus est, et"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT CH=" hūmānitātem, nōn deitātem subiacuisse passiōne, crēdō. Crēdō, eum tertiā diē resurrēxisse, hominem perditum līberāsse, ascendisse caelōs, sedēre ā dexteram Patris, ventūrum"/>
                <ITEXT FEATURES="inherit superscript" CH="7"/>
                <ITEXT CH=" ac iūdicātūrum vīvōs et mortuōs."/>
                <trail PARENT="Latin"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="136.0008" YPOS="3692.02547770701" OwnPage="7" ItemID="1625197251" PTYPE="4" WIDTH="522" HEIGHT="318.573248407643" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L522 0 L522 318.573 L0 318.573 L0 0 Z" copath="M0 0 L522 0 L522 318.573 L0 318.573 L0 0 Z" gXpos="136.0008" gYpos="3692.02547770701" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FEATURES="inherit superscript" CH="1"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="[I believe in Jesus Christ ...] having been begotten by the Father, not made, not after times, but before all time to have always been with the Father."/>
                <ITEXT CH=" The Christian doctrine of the Trinity states that there is one God, that the Father is God, that Christ is God, that the Holy Spirit is God, that the Father is not the Son nor the Holy Spirit, and the Son is not the Holy Spirit. There is one essence (or being) of God with three Divine persons. Gregory includes this in his confession to distinguish himself from the Arians, who claimed that Christ is not God, but was rather a created being. The Son is eternal, and there never was a time where He was not. For more on what 'begotten' means, see Thomas Aquinas' Summa Theologia, Part 1, Q. 27 and 28."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="2"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="For neither can [someone] be said to be a father, unless he has a son; nor especially [can someone be said] to be a son, if he does not have a father."/>
                <ITEXT CH=" Gregory's point is that the relation between the Father and the Son is eternal and not something formed in time."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="3"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="And those who say 'there was a time when He was not', I denounce with a curse and call to witness that they are separated from the church."/>
                <ITEXT CH=" The Arians claimed that there was a time when the Son did not exist."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="4"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="I believe this Word to have become flesh."/>
                <ITEXT CH=" See John 1:14 'and the Word became flesh and dwelt amongst us'; 'et Verbum carō factum est et habitāvit in nōbīs' in the Vulgate; 'Καὶ ὁ λόγος σὰρξ ἐγένετο καὶ ἐσκήνωσεν ἐν ἡμῖν' in the Greek."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="5"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="(By) whose passion the world was redeemed."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="6"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="[I believe] his humanity, not diety, to have undergone suffering."/>
                <ITEXT CH=" Christ is one being with two natures: a divine nature united with a human nature. The divine nature cannot suffer, but the human nature can. Thus Gregory's statement that Christ suffered according to His humanity, not according to His divinity."/>
                <para PARENT="footnotes"/>
                <ITEXT FEATURES="inherit superscript" CH="7"/>
                <ITEXT FONT="DejaVu Serif Italic" CH="Coming to judge the living and the dead."/>
                <trail PARENT="footnotes"/>
            </StoryText>
        </PAGEOBJECT>
